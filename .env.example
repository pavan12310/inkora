# Copy to .env for local work. On Netlify or Vercel, set these in the host's
# environment variables instead — the build checks for them and stops with a
# list of what is missing.

# ---- Database -------------------------------------------------------------
# Neon, Supabase, Railway, or any Postgres. Free tiers are fine to start.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The NON-pooled connection string, used only for migrations.
#
# Migrations take a session-level advisory lock, and a transaction-mode pooler
# discards session state between statements — so migrating through the pooler
# fails with P1002 every time, whatever the timeout.
#   Neon     : the same host WITHOUT "-pooler"
#   Supabase : port 5432 rather than 6543
# If your provider has no separate direct connection, use the same value as
# DATABASE_URL. Required: Prisma will not fall back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@direct-host/dbname?sslmode=require"

# ---- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Google OAuth: console.cloud.google.com > Credentials > OAuth client ID
# Authorised redirect URI: https://yoursite.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Required once deployed -----------------------------------------------
# Auth.js works out its own origin to build the Google callback URL. Behind a
# serverless proxy (Netlify, Vercel) it cannot, so it refuses and sign-in fails
# with "There is a problem with the server configuration". These two fix that.
# Locally they are optional.
AUTH_URL="https://yoursite.com"
AUTH_TRUST_HOST="true"

# ---- Who can moderate -----------------------------------------------------
# Comma-separated. These accounts see the Editor's desk. Everyone else doesn't.
ADMIN_EMAILS="you@example.com"

# ---- Canonical URL --------------------------------------------------------
# No trailing slash. Used for canonical tags, sitemap.xml and the RSS feed.
NEXT_PUBLIC_SITE_URL="https://yoursite.com"

# ---- Email (optional but strongly recommended) ----------------------------
# Without this, writers submit and never hear anything back. resend.com,
# free tier covers a small publication comfortably.
RESEND_API_KEY=""
# Must be on a domain you have verified with Resend.
EMAIL_FROM="Inkora <editor@yoursite.com>"

# ---- Image uploads (optional) --------------------------------------------
# On Vercel: create a Blob store and set this.
# On Netlify: leave blank — Netlify Blobs is detected automatically.
# On neither: uploads are disabled and writers paste a cover image URL.
BLOB_READ_WRITE_TOKEN=""

# ---- Search indexing (optional) -------------------------------------------
# IndexNow tells Bing, Yandex, Seznam and Naver about a piece the moment it is
# published, rather than waiting for them to recrawl. Google does not take part;
# it finds new pieces through the sitemap and through links.
#
# Use any random 32-64 character hex string. The app serves it at
# https://yoursite.com/<key>.txt, which is how the search engines verify you
# own the site. Generate one with: openssl rand -hex 24
INDEXNOW_KEY=""

# ---- Serverless database note ---------------------------------------------
# Both Vercel and Netlify run this as serverless functions, which open a new
# connection per invocation. Use your provider's POOLED connection string, or
# you will exhaust the connection limit under any real traffic.
#   Neon     : the "-pooler" host
#   Supabase : port 6543 (the transaction pooler), not 5432
